DJANGO_SECRET_KEY=your-secret-key-here
GROK_API_BASE=https://api.x.ai/v1
GROK_API_KEY=your-xai-api-key-here
GROK_CHAT_MODEL=grok-4-fast-reasoning

# Context Graph (Neo4j) — start it with:
#   docker compose -f deploy/neo4j/docker-compose.yml --env-file .env up -d
GRAPH_ENABLED=true
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Chroma server (required: API, worker and commands share Chroma) — start it with:
#   docker compose -f deploy/chroma/docker-compose.yml --env-file .env up -d
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8100
CHROMA_UID=1001
CHROMA_GID=1001

# The live historian (the PLC's rows, TimescaleDB on this host; read-only role). Names: HIST_LIVE_DB_NAME,
# HIST_LIVE_DB_USER, HIST_LIVE_DB_HOST, HIST_LIVE_DB_PORT have defaults; only the password must be set.
HIST_LIVE_DB_PASSWORD=
# Which historian the Studio serves: march (the simulated month) or live (the PLC's rows)
HISTORIAN_SOURCE=march

